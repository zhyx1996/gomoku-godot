# Godot 4+ specific ignores
.godot/
/android/

# Export artifacts (reproducible via: godot --headless --export-release "Web")
build/

# Local tooling & session artifacts
.gdmcp/
.playwright-cli/
tests/*.log

# Development-only screenshots (not referenced by any code; excluded from export as well)
screenshots/

# Compiled binaries (sources kept in gomoku-c/)
gomoku-c/*.exe
ci3.log
ci_watch.log
